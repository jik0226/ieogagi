# Copy to .env for local development. This file holds only non-secret settings
# and paths; the secret files themselves are generated by `ieogagi-dev-secrets`
# into .secrets/ (git-ignored) and must never be committed.
IEOGAGI_ENV=development
IEOGAGI_DATABASE_URL_FILE=.secrets/database_url
IEOGAGI_OWNER_DATABASE_URL_FILE=.secrets/owner_database_url
IEOGAGI_SESSION_KEY_FILE=.secrets/session_key
IEOGAGI_NOTE_KEYRING_FILE=.secrets/note_keyring
IEOGAGI_ALLOWED_ORIGINS=["http://localhost:5173"]
