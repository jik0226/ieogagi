{
	admin off
}

{$IEOGAGI_DOMAIN} {
	encode zstd gzip

	# The block contains a delete (-Server), so Caddy applies it when the response is written
	# and plain sets overwrite upstream values. "?" keeps the app's stricter API CSP
	# (default-src 'none') and fills in the SPA policy only where none was sent.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		# Same limit as the app's BodySizeLimitMiddleware, enforced at the edge too.
		request_body {
			max_size 64KB
		}
		reverse_proxy app:8000 {
			# Replace (not append) the client address; clients cannot inject their own.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
